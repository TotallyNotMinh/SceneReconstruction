# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.venv312

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Data Directories ─────────────────────────────────────────────────────────
# Ignore everything inside data subdirectories, but keep folder structure via .gitkeep
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/output/*
!data/output/.gitkeep

# ── Project-specific: large / generated data ─────────────────────────────────
Replica-Dataset/
reid_objects_output/

# Model weights (too large for git)
*.pt
*.pth
*.onnx
*.engine

# Rendered videos
*.mp4
*.avi
*.mov

# Scene export artefacts
*.glb
*.usdz
*.gltf
*.ply

# Logs / misc
*.log
*.tmp
